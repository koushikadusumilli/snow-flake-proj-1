# Copy to .env to override defaults:  cp .env.example .env
# Every value below already has the same default in docker-compose.yml,
# so this file is optional for a first run.

# Warehouse database
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse
# Port published on your machine (the container always listens on 5432)
WAREHOUSE_HOST_PORT=5433

# Airflow UI login
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Leave blank to use the local development defaults. Set real values for any
# shared or hosted environment.
# Generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
